# Every variable is optional. The defaults are in src/evilflowers_equation/settings.py and, for the
# broker, shutdown, delivery cap, storage, logs and catalog, in evilflowers-worker's settings.py.

REDIS_URL=redis://redis:6379/7
EQUATION_QUEUE=evilflowers_equation
# Seconds before Redis redelivers an unacknowledged job. One value for every consumer of the db (default 12 h).
# BROKER_VISIBILITY_TIMEOUT=43200
# SIGTERM (scale-in, rollout): seconds the running book may continue before it is cancelled and requeued.
WORKER_SOFT_SHUTDOWN_TIMEOUT=60
# Seconds that cancel may take before the worker requeues the book itself and exits (a denied kill).
# SOFT + CANCEL must stay under the pod's terminationGracePeriodSeconds (3 h). Do not set REMAP_SIGTERM.
WORKER_CANCEL_TIMEOUT=30
# Deliveries of one message before the job is reported failed (a book that OOM-kills the worker); 0 = no cap.
# A scale-in requeue does not count.
MAX_DELIVERIES=3
STORAGE_PATH=/mnt/data

# IP-018: the job reports here, with the API key of a user holding `extraction.ingest_extraction`.
CATALOG_API_URL=http://catalog:8000
CATALOG_API_KEY=
# Seconds between reads of the run while a book is decoded (stops on a newer attempt); 0 = only before the work.
RUN_CHECK_INTERVAL=300

# Crops
CROP_DPI=200
WEBP_QUALITY=90
# Pixels per crop at most; a larger box is rendered at a lower dpi. 0 = no bound.
MAX_CROP_PIXELS=2000000

# LaTeX: onnx (LaTeX-OCR on CPU, weights in MODELS_PATH) | ollama | none
LATEX_BACKEND=onnx
MODELS_PATH=/models/latex-ocr
# ONNX Runtime threads per session: the pod's CPU limit (0 = all of the node's cores, which a CPU quota throttles).
LATEX_THREADS=4
# false: idle ORT threads sleep instead of spinning between the decoder's calls (measure under the quota).
LATEX_ALLOW_SPINNING=true
# Crops of a book decoded at once, one thread each. With LATEX_THREADS=1, set it to the CPU limit.
LATEX_WORKERS=1
# Tokens per crop at most (512 = the decoder's window).
LATEX_MAX_TOKENS=512
# Stop a crop whose last N tokens repeat a 1-8 token unit (the decoder in a loop); 0 = off.
LATEX_REPETITION_STOP=64
OLLAMA_ENDPOINT=http://ollama:11434/api/chat
# OLLAMA_API_KEY=
LATEX_MODEL=qwen2.5vl:7b
LATEX_TIMEOUT=120

# PaddleOCR-VL behind the shared vlm service (LATEX_BACKEND=paddleocr-vl, and always for the standalone task).
VLM_ENDPOINT=http://vlm.shared.svc.cluster.local/v1/formulas
# Recorded as paddleocr-vl:<revision>; the revision baked into the deployed vlm image.
VLM_MODEL_REVISION=PaddleOCR-VL-1.6@132c45f
# Crops per request (at most 32); seconds per crop in a request; tries per batch; longest wait between tries.
VLM_BATCH_SIZE=8
VLM_TIMEOUT=60
VLM_ATTEMPTS=5
VLM_MAX_WAIT=120

# Standalone task (books digitalizer, #8). Its Deployment uses REDIS_URL db 8 and no CATALOG_API_KEY.
# STANDALONE_QUEUE=evilflowers_equation.standalone
# INTERACTIVE_QUEUE=evilflowers_equation.standalone.interactive
# Render check: rendered LaTeX vs crop similarity below this marks a formula disputed (uncalibrated; 0 = off).
FORMULAS_MIN_SIMILARITY=0
# Cross-check: LaTeX-OCR reads each formula too; readings that differ are disputed (doubles CPU per crop).
FORMULAS_CROSSCHECK=false
FORMULAS_CROSSCHECK_MIN_RATIO=0.8

# Formula kind (#9): decider-vision is asked whether a doubtful formula's crop is a formula. Off by default; read
# equation_formulas_total{outcome} (the doubtful share) before switching it on. Empty values mean the default.
# DECIDER_ENABLED=false
# DECIDER_VISION_URL=http://decider-vision.shared.svc.cluster.local
# DECIDER_VISION_REVISION=
# DECIDER_TIMEOUT=60
# Calls and seconds one job may spend on judges (0 = no limit).
# JUDGE_BUDGET_CALLS=500
# JUDGE_BUDGET_SECONDS=900
# Bands only once knowledge#65 measures them: JUDGE_THRESHOLDS='{"formula_kind": {"keep": 0.8, "hide": 0.9}}'
# JUDGE_THRESHOLDS=
# JUDGE_MAX_SIDE=448

# Logs: json (one object per line with level, trace_id and run_id; what Loki parses) or text
LOG_FORMAT=json

# Telemetry. Off when neither an OTLP endpoint nor HOST_IP is set.
# In k8s the pod sets HOST_IP + OTEL_* (knowledge base: Cookbooks/Deploy-a-Service §3).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://<alloy>:4318
# OTEL_SERVICE_NAME=equation
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=elvira,deployment.environment.name=development
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0

# CPU profiling (Pyroscope SDK, Python frames). Off unless PYROSCOPE_SERVER_ADDRESS is set.
# In k8s the knowledge repo sets these for instances listed in evilflowers_instances.<env>.pyroscope_sdk.
# PYROSCOPE_SERVER_ADDRESS=http://<pyroscope>:4040
# PYROSCOPE_APPLICATION_NAME=equation
# PYROSCOPE_TAGS=namespace=evilflowers-dev,pod=<pod>,container=equation,cluster=k8s-stu
