# Every variable is optional; the defaults are in src/evilflowers_equation/settings.py.

REDIS_URL=redis://redis:6379/7
EQUATION_QUEUE=evilflowers_equation
# Seconds before Redis redelivers an unacknowledged job; longer than the longest book.
BROKER_VISIBILITY_TIMEOUT=7200
STORAGE_PATH=/mnt/data

# IP-018: the job reports here, with the API key of a user holding `extraction.ingest_extraction`.
CATALOG_API_URL=http://catalog:8000
CATALOG_API_KEY=

# Crops
CROP_DPI=200
WEBP_QUALITY=90

# LaTeX: onnx (LaTeX-OCR on CPU, weights in MODELS_PATH) | ollama | none
LATEX_BACKEND=onnx
MODELS_PATH=/models/latex-ocr
# ONNX Runtime threads per session: the pod's CPU limit (0 = all of the node's cores, which a CPU quota throttles).
LATEX_THREADS=4
# false: idle ORT threads sleep instead of spinning between the decoder's calls (measure under the quota).
LATEX_ALLOW_SPINNING=true
# Crops of a book decoded at once, one thread each. With LATEX_THREADS=1, set it to the CPU limit.
LATEX_WORKERS=1
# Tokens per crop at most (512 = the decoder's window).
LATEX_MAX_TOKENS=512
# Stop a crop whose last N tokens repeat a 1-8 token unit (the decoder in a loop); 0 = off.
LATEX_REPETITION_STOP=64
OLLAMA_ENDPOINT=http://ollama:11434/api/chat
# OLLAMA_API_KEY=
LATEX_MODEL=qwen2.5vl:7b
LATEX_TIMEOUT=120

# Logs: json (one object per line with level, trace_id and run_id; what Loki parses) or text
LOG_FORMAT=json

# Telemetry. Off when neither an OTLP endpoint nor HOST_IP is set.
# In k8s the pod sets HOST_IP + OTEL_* (knowledge base: Cookbooks/Deploy-a-Service §3).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://<alloy>:4318
# OTEL_SERVICE_NAME=equation
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=elvira,deployment.environment.name=development
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0

# CPU profiling (Pyroscope SDK, Python frames). Off unless PYROSCOPE_SERVER_ADDRESS is set.
# In k8s the knowledge repo sets these for instances listed in evilflowers_instances.<env>.pyroscope_sdk.
# PYROSCOPE_SERVER_ADDRESS=http://<pyroscope>:4040
# PYROSCOPE_APPLICATION_NAME=equation
# PYROSCOPE_TAGS=namespace=evilflowers-dev,pod=<pod>,container=equation,cluster=k8s-stu
